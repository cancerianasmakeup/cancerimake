{
  "name": "cancerianas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace=@cancerianas/web",
    "web:build": "npm run build --workspace=@cancerianas/web",
    "mobile:start": "npm run start --workspace=@cancerianas/mobile",
    "mobile:android": "npm run android --workspace=@cancerianas/mobile",
    "mobile:build:android": "npm run build:android --workspace=@cancerianas/mobile"
  },
  "overrides": {
    "ajv": "$ajv",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "pg": "^8.23.0"
  }
}
